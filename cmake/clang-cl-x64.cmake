set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
if(NOT DEFINED ENV{MP_LLVM_ROOT} OR NOT DEFINED ENV{MP_WINDOWS_SDK})
  message(FATAL_ERROR "Set MP_LLVM_ROOT and MP_WINDOWS_SDK for the LLVM and xwin SDK directories")
endif()
set(MP_LLVM "$ENV{MP_LLVM_ROOT}")
set(MP_SDK "$ENV{MP_WINDOWS_SDK}")
set(CMAKE_C_COMPILER "$ENV{MP_CLANG_CL}")
set(CMAKE_CXX_COMPILER "$ENV{MP_CLANG_CL}")
set(CMAKE_C_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_AR "${MP_LLVM}/bin/llvm-lib")
set(CMAKE_LINKER "${MP_LLVM}/bin/lld-link")
set(CMAKE_RC_COMPILER "${MP_LLVM}/bin/llvm-rc")
set(CMAKE_MT "${MP_LLVM}/bin/llvm-mt")
set(MP_OVERLAY_FLAGS "")
if(DEFINED ENV{MP_WINDOWS_OVERLAY})
  set(MP_OVERLAY_FLAGS "/clang:-ivfsoverlay /clang:$ENV{MP_WINDOWS_OVERLAY}")
endif()
set(CMAKE_C_FLAGS_INIT "/clang:-resource-dir=${MP_LLVM}/lib/clang/19 /clang:-fms-compatibility-version=19.44 ${MP_OVERLAY_FLAGS} /imsvc${MP_SDK}/crt/include /imsvc${MP_SDK}/sdk/include/ucrt /imsvc${MP_SDK}/sdk/include/shared /imsvc${MP_SDK}/sdk/include/um /imsvc${MP_SDK}/sdk/include/winrt")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT}")
set(CMAKE_RC_FLAGS_INIT "-I${MP_SDK}/crt/include -I${MP_SDK}/sdk/include/ucrt -I${MP_SDK}/sdk/include/shared -I${MP_SDK}/sdk/include/um")
set(MP_LIBPATHS "/libpath:${MP_SDK}/crt/lib/x86_64 /libpath:${MP_SDK}/sdk/lib/ucrt/x86_64 /libpath:${MP_SDK}/sdk/lib/um/x86_64")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${MP_LIBPATHS}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${MP_LIBPATHS}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${MP_LIBPATHS}")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_FIND_ROOT_PATH "${MP_SDK}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
